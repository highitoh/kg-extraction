# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Comment out the environment variables for the provider you are NOT using

# ----------------------------------------------------------------------------
# Common Configuration
# ----------------------------------------------------------------------------
# Select the LLM backend used by LLMFactory.
# Supported values: gemini_api, gcp_vertexai, openai_api, azure_openai
LLM_PROVIDER=gemini_api
#
# Optional integer seed used when constructing Gemini clients.
# Set a fixed value to make repeated runs with the same inputs more reproducible.
# Change or remove it when you want output variation instead.
LLM_SEED=42

# ----------------------------------------------------------------------------
# Gemini API Configuration
# ----------------------------------------------------------------------------
# Set LLM_PROVIDER=gemini_api when using this path. Vertex AI uses ADC or
# GOOGLE_APPLICATION_CREDENTIALS instead.
GEMINI_API_KEY=youre_gemini_api_key_here

# ----------------------------------------------------------------------------
# Google Cloud / Vertex AI Configuration
# ----------------------------------------------------------------------------
# Set LLM_PROVIDER=gcp_vertexai to route Gemini requests through Vertex AI instead
# of the Gemini Developer API.
#
# Required when LLM_PROVIDER=gcp_vertexai.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#
# Optional. Defaults to "global" when omitted.
# GOOGLE_CLOUD_LOCATION=global
#
# Optional when using a service account JSON file stored under /workspace.
# If you authenticate with `gcloud auth application-default login`, leave this
# unset and rely on the mounted ~/.config/gcloud directory in docker-compose.yml.
# GOOGLE_APPLICATION_CREDENTIALS=/workspace/app/credentials/application_default_credentials.json

# ----------------------------------------------------------------------------
# OpenAI API Configuration
# ----------------------------------------------------------------------------
# Set LLM_PROVIDER=openai_api when using this path.
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------------------------------------
# Azure OpenAI Service Configuration
# ----------------------------------------------------------------------------
# Set LLM_PROVIDER=azure_openai when using this path.
# AZURE_OPENAI_API_KEY=your_azure_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21

# ----------------------------------------------------------------------------
# Miro API Configuration
# ----------------------------------------------------------------------------
# Miro REST API v2 access token (OAuth 2.0)
# Obtain from Miro Developer Portal: https://developers.miro.com/
MIRO_API_KEY=your_miro_api_token_here
MIRO_BASE_URL=https://api.miro.com/v2

# ----------------------------------------------------------------------------
# Jira Cloud API Configuration
# ----------------------------------------------------------------------------
# Jira Cloud REST API v3 credentials
# Email: Your Jira account email (used for Basic Auth)
# API Token: Generate at https://id.atlassian.com/manage-profile/security/api-tokens
# Instance Domain: Your Jira instance domain (e.g., "your-company.atlassian.net")
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_INSTANCE_DOMAIN=your-company.atlassian.net

# ----------------------------------------------------------------------------
# GitHub API Configuration
# ----------------------------------------------------------------------------
# GitHub Personal Access Token (optional for public repositories)
# Without token: 60 requests/hour. With token: 5,000 requests/hour.
# Create token at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
