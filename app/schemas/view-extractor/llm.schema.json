{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/view-extractor/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViewExtractorLLMOutput",
  "description": "LLM output schema for ViewExtractor",
  "type": "object",
  "properties": {
    "value_analysis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Text related to value analysis"
    },
    "business_concept": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Text related to business concepts"
    },
    "business_requirement": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Text related to business requirements"
    },
    "system_requirement": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Text related to system requirements"
    },
    "system_component": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Text related to system components"
    },
    "data_analysis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Text related to data analysis"
    }
  },
  "required": [
    "value_analysis",
    "business_concept",
    "business_requirement",
    "system_requirement",
    "system_component",
    "data_analysis"
  ],
  "additionalProperties": false
}