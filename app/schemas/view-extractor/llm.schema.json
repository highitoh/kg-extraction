{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/view-extractor/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViewExtractorLLMOutput",
  "description": "LLM output schema for ViewExtractor - CSV classification format",
  "type": "object",
  "properties": {
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Sentence ID from input CSV"
          },
          "labels": {
            "type": "string",
            "description": "Pipe-delimited label codes (e.g., VA|BC or NO)"
          }
        },
        "required": ["id", "labels"],
        "additionalProperties": false
      }
    }
  },
  "required": ["classifications"],
  "additionalProperties": false
}
