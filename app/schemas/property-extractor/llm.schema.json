{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-extractor/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyExtractorLLMOutput",
  "description": "LLM output schema for PropertyExtractor",
  "type": "object",
  "properties": {
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src_id": {
            "type": "string",
            "description": "The ID of the source class"
          },
          "dest_id": {
            "type": "string",
            "description": "The ID of the destination class"
          }
        },
        "required": ["src_id", "dest_id"],
        "additionalProperties": false
      },
      "description": "Array of property relationships between classes"
    }
  },
  "required": ["properties"],
  "additionalProperties": false
}
