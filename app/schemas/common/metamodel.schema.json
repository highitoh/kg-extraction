{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/common/metamodel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metamodel",
  "type": "object",
  "description": "Metamodel definition",
  "properties": {
    "classes": {
      "type": "array",
      "description": "Classes defined in the metamodel",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "iri": {
            "type": "string",
            "format": "uri",
            "description": "Identifier (IRI)"
          }
        },
        "required": ["iri"]
      }
    },
    "properties": {
      "type": "array",
      "description": "Properties defined in the metamodel",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "iri": {
            "type": "string",
            "format": "uri",
            "description": "Identifier (IRI)"
          },
          "src_iri": {
            "type": "string",
            "format": "uri",
            "description": "IRI of the source class for the property"
          },
          "dest_iri": {
            "type": "string",
            "format": "uri",
            "description": "IRI of the destination class for the property"
          }
        },
        "required": ["iri", "src_iri", "dest_iri"]
      }
    }
  },
  "required": ["classes", "properties"],
  "additionalProperties": false
}
