{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Issue Classification Output",
  "description": "Output schema for issue classification results",
  "type": "object",
  "properties": {
    "classification_id": {
      "type": "string",
      "description": "Unique identifier for this classification run"
    },
    "timestamp": {
      "type": "string",
      "description": "Timestamp in YYYYMMDD_HHMMSS format"
    },
    "validator_result_file": {
      "type": "string",
      "description": "Path to the validator result file used as input"
    },
    "knowledge_file": {
      "type": "string",
      "description": "Path to the knowledge file"
    },
    "extraction_result_file": {
      "type": "string",
      "description": "Path to the extraction result file"
    },
    "class_validations": {
      "type": "array",
      "description": "Class validation results with issue labels",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {"type": "string"},
          "class_label": {"type": "string"},
          "necessity": {
            "type": "object",
            "properties": {
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "justification": {"type": "string"}
            },
            "required": ["score", "justification"]
          },
          "understandability": {
            "type": "object",
            "properties": {
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "justification": {"type": "string"}
            },
            "required": ["score", "justification"]
          },
          "boundary_suitability": {
            "type": "object",
            "properties": {
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "justification": {"type": "string"}
            },
            "required": ["score", "justification"]
          },
          "conceptual_structure_validity": {
            "type": "object",
            "properties": {
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "justification": {"type": "string"}
            },
            "required": ["score", "justification"]
          },
          "issue_labels": {
            "type": "array",
            "description": "Issue labels assigned by IssueClassifier",
            "items": {"type": "string"}
          }
        },
        "required": ["class_id", "class_label", "necessity", "understandability", "boundary_suitability", "conceptual_structure_validity", "issue_labels"]
      }
    },
    "property_validations": {
      "type": "array",
      "description": "Property validation results with issue labels",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {"type": "string"},
          "src_label": {"type": "string"},
          "property_iri": {"type": "string"},
          "dest_label": {"type": "string"},
          "relation_type_validity": {
            "type": "object",
            "properties": {
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "justification": {"type": "string"}
            },
            "required": ["score", "justification"]
          },
          "strength_validity": {
            "type": "object",
            "properties": {
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "justification": {"type": "string"}
            },
            "required": ["score", "justification"]
          },
          "issue_labels": {
            "type": "array",
            "description": "Issue labels assigned by IssueClassifier",
            "items": {"type": "string"}
          }
        },
        "required": ["property_id", "src_label", "property_iri", "dest_label", "relation_type_validity", "strength_validity", "issue_labels"]
      }
    }
  },
  "required": ["classification_id", "timestamp", "validator_result_file", "knowledge_file", "extraction_result_file", "class_validations", "property_validations"],
  "additionalProperties": false
}
