{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Issue Classifier - Property Issues LLM Response",
  "description": "LLM response schema for property issue classification",
  "type": "object",
  "properties": {
    "property_issues": {
      "type": "array",
      "description": "List of property issue classifications",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "UUID of the property being classified"
          },
          "issue_labels": {
            "type": "array",
            "description": "List of issue labels (free-form, UPPER_SNAKE_CASE)",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["property_id", "issue_labels"],
        "additionalProperties": false
      }
    }
  },
  "required": ["property_issues"],
  "additionalProperties": false
}
