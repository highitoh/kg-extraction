{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeValidationLLMResponse",
  "description": "LLM response schema for Knowledge Validation",
  "type": "object",
  "properties": {
    "class_validation": {
      "type": "object",
      "description": "Validation result for a single class",
      "properties": {
        "class_id": {
          "type": "string"
        },
        "class_label": {
          "type": "string"
        },
        "necessity": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Score from 1 (lowest) to 5 (highest)"
            },
            "justification": {
              "type": "string",
              "description": "Detailed explanation for the score"
            }
          },
          "required": ["score", "justification"]
        },
        "understandability": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Score from 1 (lowest) to 5 (highest)"
            },
            "justification": {
              "type": "string",
              "description": "Detailed explanation for the score"
            }
          },
          "required": ["score", "justification"]
        },
        "boundary_suitability": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Score from 1 (lowest) to 5 (highest)"
            },
            "justification": {
              "type": "string",
              "description": "Detailed explanation for the score"
            }
          },
          "required": ["score", "justification"]
        },
        "conceptual_structure_validity": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Score from 1 (lowest) to 5 (highest)"
            },
            "justification": {
              "type": "string",
              "description": "Detailed explanation for the score"
            }
          },
          "required": ["score", "justification"]
        }
      },
      "required": ["class_id", "class_label", "necessity", "understandability", "boundary_suitability", "conceptual_structure_validity"]
    },
    "property_validation": {
      "type": "object",
      "description": "Validation result for a single property",
      "properties": {
        "property_id": {
          "type": "string"
        },
        "src_label": {
          "type": "string"
        },
        "property_iri": {
          "type": "string"
        },
        "dest_label": {
          "type": "string"
        },
        "relation_type_validity": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Score from 1 (lowest) to 5 (highest)"
            },
            "justification": {
              "type": "string",
              "description": "Detailed explanation for the score"
            }
          },
          "required": ["score", "justification"]
        },
        "strength_validity": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Score from 1 (lowest) to 5 (highest)"
            },
            "justification": {
              "type": "string",
              "description": "Detailed explanation for the score"
            }
          },
          "required": ["score", "justification"]
        }
      },
      "required": ["property_id", "src_label", "property_iri", "dest_label", "relation_type_validity", "strength_validity"]
    }
  },
  "oneOf": [
    {
      "required": ["class_validation"]
    },
    {
      "required": ["property_validation"]
    }
  ]
}
