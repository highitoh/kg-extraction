{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeValidationReport",
  "description": "Output schema for Knowledge Validation Report",
  "type": "object",
  "properties": {
    "validation_id": {
      "type": "string",
      "description": "Unique validation ID"
    },
    "timestamp": {
      "type": "string",
      "description": "Timestamp in YYYYMMDDhhmmss format"
    },
    "knowledge_file": {
      "type": "string",
      "description": "Path to knowledge.json file"
    },
    "extraction_result_file": {
      "type": "string",
      "description": "Path to extraction_result_XXX.json file"
    },
    "class_validations": {
      "type": "array",
      "description": "Validation results for each class",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "string"
          },
          "class_label": {
            "type": "string"
          },
          "necessity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "justification": {
                "type": "string"
              }
            },
            "required": ["score", "justification"]
          },
          "understandability": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "justification": {
                "type": "string"
              }
            },
            "required": ["score", "justification"]
          },
          "boundary_suitability": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "justification": {
                "type": "string"
              }
            },
            "required": ["score", "justification"]
          },
          "conceptual_structure_validity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "justification": {
                "type": "string"
              }
            },
            "required": ["score", "justification"]
          }
        },
        "required": ["class_id", "class_label", "necessity", "understandability", "boundary_suitability", "conceptual_structure_validity"]
      }
    },
    "property_validations": {
      "type": "array",
      "description": "Validation results for each property",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "src_label": {
            "type": "string"
          },
          "property_iri": {
            "type": "string"
          },
          "dest_label": {
            "type": "string"
          },
          "relation_type_validity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "justification": {
                "type": "string"
              }
            },
            "required": ["score", "justification"]
          },
          "strength_validity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "justification": {
                "type": "string"
              }
            },
            "required": ["score", "justification"]
          }
        },
        "required": ["property_id", "src_label", "property_iri", "dest_label", "relation_type_validity", "strength_validity"]
      }
    }
  },
  "required": ["validation_id", "timestamp", "knowledge_file", "extraction_result_file", "class_validations", "property_validations"]
}
