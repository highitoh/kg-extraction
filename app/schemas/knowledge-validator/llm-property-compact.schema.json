{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertyValidationBatchCompactResponse",
  "description": "Compact LLM response schema for Batch Property Validation (scores only, no justifications)",
  "type": "object",
  "properties": {
    "property_validations": {
      "type": "array",
      "description": "Validation results for multiple properties with the same property_iri",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "S21": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Relation Applicability score"
          },
          "S22": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Relation Unity score"
          },
          "S23": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Strength Validity score"
          },
          "S24": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Contextual Grounding score"
          }
        },
        "required": ["property_id", "S21", "S22", "S23", "S24"],
        "additionalProperties": false
      }
    }
  },
  "required": ["property_validations"],
  "additionalProperties": false
}
