{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassValidationBatchResponse",
  "description": "LLM response schema for Batch Class Validation",
  "type": "object",
  "properties": {
    "class_validations": {
      "type": "array",
      "description": "Validation results for multiple classes with the same class_iri",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "string"
          },
          "class_iri": {
            "type": "string"
          },
          "class_label": {
            "type": "string"
          },
          "necessity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Score from 1 (lowest) to 5 (highest)"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "understandability": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Score from 1 (lowest) to 5 (highest)"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "boundary_suitability": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Score from 1 (lowest) to 5 (highest)"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "conceptual_structure_validity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Score from 1 (lowest) to 5 (highest)"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          }
        },
        "required": ["class_id", "class_iri", "class_label", "necessity", "understandability", "boundary_suitability", "conceptual_structure_validity"],
        "additionalProperties": false
      }
    }
  },
  "required": ["class_validations"],
  "additionalProperties": false
}
