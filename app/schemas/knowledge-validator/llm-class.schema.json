{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassValidationBatchResponse",
  "description": "LLM response schema for Batch Class Validation",
  "type": "object",
  "properties": {
    "class_validations": {
      "type": "array",
      "description": "Validation results for multiple classes with the same class_iri",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "string"
          },
          "necessity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Score from 1 (lowest) to 5 (highest)"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "understandability": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Score from 1 (lowest) to 5 (highest)"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "unity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Unity score - evaluates whether the class does not semantically overlap with other classes"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "boundary_suitability": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Score from 1 (lowest) to 5 (highest)"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "structural_validity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Structural validity score - evaluates whether the class is properly defined as a metamodel element and hierarchical structure is consistent"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "text_grounding": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Text grounding score - evaluates whether the class is extracted based on the document description"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          }
        },
        "required": ["class_id", "necessity", "understandability", "unity", "boundary_suitability", "structural_validity", "text_grounding"],
        "additionalProperties": false
      }
    }
  },
  "required": ["class_validations"],
  "additionalProperties": false
}
