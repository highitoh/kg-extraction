{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertyValidationBatchResponse",
  "description": "LLM response schema for Batch Property Validation",
  "type": "object",
  "properties": {
    "property_validations": {
      "type": "array",
      "description": "Validation results for multiple properties with the same property_iri",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "src_label": {
            "type": "string"
          },
          "property_iri": {
            "type": "string"
          },
          "dest_label": {
            "type": "string"
          },
          "relation_applicability": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Relation applicability score - evaluates whether a relationship should be defined between the two connected classes"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "relation_unity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Relation unity score - evaluates whether the property does not semantically overlap with other relationships"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "strength_validity": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Strength validity score - evaluates whether the determination of the property's relationship strength is appropriate"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          },
          "contextual_grounding": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Contextual grounding score - evaluates whether the property can be recognized as having a relationship from the context within the document"
              },
              "justification": {
                "type": "string",
                "description": "Detailed explanation for the score"
              }
            },
            "required": ["score", "justification"],
            "additionalProperties": false
          }
        },
        "required": ["property_id", "src_label", "property_iri", "dest_label", "relation_applicability", "relation_unity", "strength_validity", "contextual_grounding"],
        "additionalProperties": false
      }
    }
  },
  "required": ["property_validations"],
  "additionalProperties": false
}
