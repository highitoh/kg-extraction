{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/class-consolidator/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassConsolidatorLLMOutput",
  "type": "object",
  "description": "LLM output schema for ClassConsolidator",
  "properties": {
    "groups": {
      "type": "array",
      "description": "List of similar class groups",
      "items": {
        "type": "object",
        "properties": {
          "indices": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "description": "Index list of labels representing the same concept (0-indexed)"
          },
          "canonical_label": {
            "type": "string",
            "description": "Canonical label for the group (must exactly match one of the input labels)"
          },
          "reason": {
            "type": "string",
            "description": "Reason for selection (for logging/debugging)"
          }
        },
        "required": ["indices", "canonical_label", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["groups"],
  "additionalProperties": false
}
