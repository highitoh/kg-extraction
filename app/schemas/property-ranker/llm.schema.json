{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-ranker/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyRankerLLMOutput",
  "type": "object",
  "description": "LLM output schema for PropertyRanker",
  "properties": {
    "relations": {
      "type": "array",
      "description": "List of relationship strength evaluations",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "src_id": {
            "type": "string",
            "description": "Source class instance ID for the relationship"
          },
          "dest_id": {
            "type": "string",
            "description": "Destination class instance ID for the relationship"
          },
          "strength": {
            "type": "integer",
            "description": "Relationship strength: 0=None (no relation), 1=Weak (contextual dependency), 2=Medium (functional dependency), 3=Strong (essential dependency)",
            "minimum": 0,
            "maximum": 3
          },
          "justification": {
            "type": "string",
            "description": "Justification for the strength evaluation"
          }
        },
        "required": ["src_id", "dest_id", "strength", "justification"]
      }
    }
  },
  "required": ["relations"],
  "additionalProperties": false
}
