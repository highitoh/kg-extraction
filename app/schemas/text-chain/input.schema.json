{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/text-chain/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextChainInput",
  "type": "object",
  "description": "Input information for TextChain",
  "properties": {
    "files": {
      "type": "array",
      "description": "Target file information for processing",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "File path"
          }
        },
        "required": ["path"]
      }
    }
  },
  "required": ["files"],
  "additionalProperties": false
}
