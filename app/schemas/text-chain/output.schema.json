{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/text-chain/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextChainOutput",
  "type": "object",
  "description": "Output information for TextChain",
  "properties": {
    "file_id": {
      "type": "string",
      "description": "Stable file ID"
    },
    "file_name": {
      "type": "string",
      "description": "Processed file name"
    },
    "sentences": {
      "type": "array",
      "description": "Extracted and filtered sentence information",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "description": "Extracted text"
          }
        },
        "required": ["text"]
      }
    }
  },
  "required": ["file_id", "file_name", "sentences"],
  "additionalProperties": false
}
