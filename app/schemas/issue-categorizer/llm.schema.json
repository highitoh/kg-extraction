{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/highitoh/kg-extraction/schemas/issue-categorizer/llm.schema.json",
  "title": "Issue Categorizer - LLM Response",
  "description": "LLM response schema for issue categorization",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Clear, descriptive category name in English"
          },
          "description": {
            "type": "string",
            "description": "Concise explanation of what this category covers"
          },
          "issue_labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of issue labels belonging to this category"
          }
        },
        "required": ["category", "description", "issue_labels"],
        "additionalProperties": false
      }
    }
  },
  "required": ["categories"],
  "additionalProperties": false
}
