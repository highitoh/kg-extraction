{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-validator/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyValidatorInput",
  "type": "object",
  "description": "Input information for PropertyValidator",
  "properties": {
    "property_candidates": {
      "$ref": "https://github.com/highitoh/kg-extraction/schemas/property-reviewer/output.schema.json",
      "description": "PropertyReviewer output (filtered property information)"
    },
    "class_info": {
      "$ref": "https://github.com/highitoh/kg-extraction/schemas/class-chain/output.schema.json",
      "description": "ClassReviewer output (class information)"
    },
    "metamodel": {
      "$ref": "https://github.com/highitoh/kg-extraction/schemas/common/metamodel.schema.json",
      "description": "Metamodel definition"
    }
  },
  "required": ["property_candidates", "class_info", "metamodel"],
  "additionalProperties": false
}
