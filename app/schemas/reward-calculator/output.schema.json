{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/reward-calculator/output.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RewardCalculationReport",
  "description": "Output schema for reward calculation report",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "Timestamp in YYYYMMDDhhmmss format"
    },
    "class_scores": {
      "type": "array",
      "description": "Quality scores for each class",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "string"
          },
          "class_label": {
            "type": "string"
          },
          "dimension_scores": {
            "type": "object",
            "properties": {
              "necessity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Necessity score - whether the class should be extracted as knowledge"
              },
              "understandability": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Understandability score - whether the meaning can be clearly understood from the class name"
              },
              "unity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Unity score - whether the class does not semantically overlap with other classes"
              },
              "boundary_suitability": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Boundary suitability score - whether the class does not include multiple concepts"
              },
              "structural_validity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Structural validity score - whether the class is properly defined as a metamodel element"
              },
              "text_grounding": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Text grounding score - whether the class is extracted based on the document description"
              }
            },
            "required": [
              "necessity",
              "understandability",
              "unity",
              "boundary_suitability",
              "structural_validity",
              "text_grounding"
            ]
          },
          "quality_score": {
            "type": "number"
          }
        },
        "required": [
          "class_id",
          "class_label",
          "dimension_scores",
          "quality_score"
        ]
      }
    },
    "property_scores": {
      "type": "array",
      "description": "Quality scores for each property",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "src_label": {
            "type": "string"
          },
          "property_iri": {
            "type": "string"
          },
          "dest_label": {
            "type": "string"
          },
          "dimension_scores": {
            "type": "object",
            "properties": {
              "relation_applicability": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Relation applicability score - whether a relationship should be defined between the two connected classes"
              },
              "relation_unity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Relation unity score - whether the property does not semantically overlap with other relationships"
              },
              "strength_validity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Strength validity score - whether the determination of the property's relationship strength is appropriate"
              },
              "contextual_grounding": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Contextual grounding score - whether the property can be recognized from the document context"
              }
            },
            "required": [
              "relation_applicability",
              "relation_unity",
              "strength_validity",
              "contextual_grounding"
            ]
          },
          "quality_score": {
            "type": "number"
          }
        },
        "required": [
          "property_id",
          "src_label",
          "property_iri",
          "dest_label",
          "dimension_scores",
          "quality_score"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_classes": {
          "type": "integer"
        },
        "total_properties": {
          "type": "integer"
        },
        "total_class_quality_score": {
          "type": "number"
        },
        "total_property_quality_score": {
          "type": "number"
        },
        "property_weight": {
          "type": "number",
          "description": "Weight applied to property scores: metamodel_classes / (2 * metamodel_properties)"
        },
        "combined_total_quality_score": {
          "type": "number"
        },
        "average_class_score": {
          "type": "number"
        },
        "average_property_score": {
          "type": "number"
        },
        "overall_average_score": {
          "type": "number"
        }
      },
      "required": [
        "total_classes",
        "total_properties",
        "total_class_quality_score",
        "total_property_quality_score",
        "combined_total_quality_score"
      ]
    }
  },
  "required": [
    "timestamp",
    "class_scores",
    "property_scores",
    "summary"
  ]
}
