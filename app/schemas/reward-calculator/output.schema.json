{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/reward-calculator/output.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RewardCalculationReport",
  "description": "Output schema for reward calculation report",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "Timestamp in YYYYMMDDhhmmss format"
    },
    "class_scores": {
      "type": "array",
      "description": "Quality scores for each class",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "string"
          },
          "class_label": {
            "type": "string"
          },
          "dimension_scores": {
            "type": "object",
            "properties": {
              "necessity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "understandability": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "boundary_suitability": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "conceptual_structure_validity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "necessity",
              "understandability",
              "boundary_suitability",
              "conceptual_structure_validity"
            ]
          },
          "quality_score": {
            "type": "number"
          }
        },
        "required": [
          "class_id",
          "class_label",
          "dimension_scores",
          "quality_score"
        ]
      }
    },
    "property_scores": {
      "type": "array",
      "description": "Quality scores for each property",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "src_label": {
            "type": "string"
          },
          "property_iri": {
            "type": "string"
          },
          "dest_label": {
            "type": "string"
          },
          "dimension_scores": {
            "type": "object",
            "properties": {
              "relation_type_validity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "strength_validity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "relation_type_validity",
              "strength_validity"
            ]
          },
          "quality_score": {
            "type": "number"
          }
        },
        "required": [
          "property_id",
          "src_label",
          "property_iri",
          "dest_label",
          "dimension_scores",
          "quality_score"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_classes": {
          "type": "integer"
        },
        "total_properties": {
          "type": "integer"
        },
        "total_class_quality_score": {
          "type": "number"
        },
        "total_property_quality_score": {
          "type": "number"
        },
        "combined_total_quality_score": {
          "type": "number"
        },
        "average_class_score": {
          "type": "number"
        },
        "average_property_score": {
          "type": "number"
        },
        "overall_average_score": {
          "type": "number"
        }
      },
      "required": [
        "total_classes",
        "total_properties",
        "total_class_quality_score",
        "total_property_quality_score",
        "combined_total_quality_score"
      ]
    }
  },
  "required": [
    "timestamp",
    "class_scores",
    "property_scores",
    "summary"
  ]
}
