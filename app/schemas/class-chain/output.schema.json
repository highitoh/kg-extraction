{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/class-chain/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassChainOutput",
  "type": "object",
  "description": "Output information for class extraction",
  "properties": {
    "id": {
      "type": "string",
      "description": "Extraction ID"
    },
    "classes": {
      "type": "array",
      "description": "Extracted class instance information",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Class instance ID"
          },
          "class_iri": {
            "type": "string",
            "format": "uri",
            "description": "Class IRI from the metamodel"
          },
          "label": {
            "type": "string",
            "description": "Extracted class label"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Source texts (multiple). Has 1:1 correspondence with file_ids, where sources[i] corresponds to file_ids[i]. Array length must match file_ids."
          },
          "file_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Source file IDs (multiple). Has 1:1 correspondence with sources, where file_ids[i] corresponds to sources[i]. Array length must match sources."
          }
        },
        "required": ["id", "class_iri", "label", "sources", "file_ids"]
      }
    }
  },
  "required": ["id", "classes"],
  "additionalProperties": false
}
