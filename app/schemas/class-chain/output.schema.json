{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/class-chain/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassChainOutput",
  "type": "object",
  "description": "クラス抽出の出力情報",
  "properties": {
    "id": {
      "type": "string",
      "description": "抽出ID"
    },
    "classes": {
      "type": "array",
      "description": "クラス個体の抽出情報",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "クラス個体ID"
          },
          "class_iri": {
            "type": "string",
            "format": "uri",
            "description": "メタモデルのクラスIRI。"
          },
          "label": {
            "type": "string",
            "description": "抽出クラス"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "抽出元文章（複数）。file_idsと1:1対応し、sources[i]はfile_ids[i]に対応する。配列長はfile_idsと同じである必要がある。"
          },
          "file_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "抽出元ファイルID（複数）。sourcesと1:1対応し、file_ids[i]はsources[i]に対応する。配列長はsourcesと同じである必要がある。"
          }
        },
        "required": ["id", "class_iri", "label", "sources", "file_ids"]
      }
    }
  },
  "required": ["id", "classes"],
  "additionalProperties": false
}
