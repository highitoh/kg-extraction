{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/class-extractor/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassExtractorLLMOutput",
  "description": "LLM output schema for ClassExtractor",
  "type": "object",
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "description": "Class type"
          },
          "label": {
            "type": "string",
            "description": "Name of the extracted instance"
          },
          "source": {
            "type": "string",
            "description": "Source text"
          }
        },
        "required": ["class", "label", "source"],
        "additionalProperties": false
      },
      "description": "Extracted class information"
    }
  },
  "required": ["classes"],
  "additionalProperties": false
}