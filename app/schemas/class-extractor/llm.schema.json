{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/class-extractor/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassExtractorLLMOutput",
  "description": "ClassExtractorのLLM出力スキーマ",
  "type": "object",
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "description": "クラスの種類"
          },
          "label": {
            "type": "string",
            "description": "抽出したインスタンスの名前"
          },
          "source": {
            "type": "string",
            "description": "抽出元の文章"
          }
        },
        "required": ["class", "label", "source"],
        "additionalProperties": false
      },
      "description": "抽出したクラス情報"
    }
  },
  "required": ["classes"],
  "additionalProperties": false
}