{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-reviewer/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyReviewerInput",
  "type": "object",
  "description": "Input information for property filter",
  "properties": {
    "property_candidates": {
      "$ref": "https://github.com/highitoh/kg-extraction/schemas/property-chain/output.schema.json",
      "description": "PropertyExtractor output (candidate property information)"
    },
    "class_info": {
      "$ref": "https://github.com/highitoh/kg-extraction/schemas/class-chain/output.schema.json",
      "description": "ClassReviewer output (class information)"
    }
  },
  "required": ["property_candidates", "class_info"],
  "additionalProperties": false
}
