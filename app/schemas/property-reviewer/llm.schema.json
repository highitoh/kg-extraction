{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-reviewer/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyReviewerLLMOutput",
  "description": "PropertyReviewerのLLM出力スキーマ",
  "type": "object",
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src_id": {
            "type": "string",
            "description": "The ID of the source class"
          },
          "dest_id": {
            "type": "string",
            "description": "The ID of the destination class"
          },
          "judgment": {
            "type": "string",
            "enum": ["ACCEPT", "REVIEW", "REJECT"],
            "description": "The judgment category for the property relation"
          },
          "evaluated_strength": {
            "type": "integer",
            "description": "Re-evaluated strength: 0=None, 1=Weak, 2=Medium, 3=Strong",
            "minimum": 0,
            "maximum": 3
          },
          "justification": {
            "type": "string",
            "description": "Combined justification for prohibit_rule evaluation and strength assessment"
          }
        },
        "required": ["src_id", "dest_id", "judgment", "evaluated_strength", "justification"],
        "additionalProperties": false
      },
      "description": "Array of property relation judgments with 3-tier judgment"
    }
  },
  "required": ["relations"],
  "additionalProperties": false
}
