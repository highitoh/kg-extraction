{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-chain/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyChainOutput",
  "type": "object",
  "description": "Output information for property (relationship) extraction",
  "properties": {
    "id": {
      "type": "string",
      "description": "Extraction ID"
    },
    "properties": {
      "type": "array",
      "description": "Property extraction information",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Property ID"
          },
          "src_id": {
            "type": "string",
            "description": "Source class instance ID for the relationship"
          },
          "src_label": {
            "type": "string",
            "description": "Label of the source class"
          },
          "property_iri": {
            "type": "string",
            "format": "uri",
            "description": "Property IRI defined in the metamodel"
          },
          "dest_id": {
            "type": "string",
            "description": "Destination class instance ID for the relationship"
          },
          "dest_label": {
            "type": "string",
            "description": "Label of the destination class"
          },
          "strength": {
            "type": "integer",
            "description": "Relationship strength: 0=None (no relation), 1=Weak (contextual dependency), 2=Medium (functional dependency), 3=Strong (essential dependency)",
            "minimum": 0,
            "maximum": 3
          },
          "judgment": {
            "type": "string",
            "enum": ["ACCEPT", "REVIEW", "REJECT"],
            "description": "Judgment category (ACCEPT/REVIEW/REJECT)"
          },
          "justification": {
            "type": "string",
            "description": "Justification for the judgment"
          }
        },
        "required": ["id", "src_id", "src_label", "property_iri", "dest_id", "dest_label", "strength", "judgment", "justification"]
      }
    }
  },
  "required": ["id", "properties"],
  "additionalProperties": false
}
