{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-chain/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyChainOutput",
  "type": "object",
  "description": "プロパティ（関係）抽出の出力情報",
  "properties": {
    "id": {
      "type": "string",
      "description": "抽出ID"
    },
    "properties": {
      "type": "array",
      "description": "プロパティ抽出情報",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "プロパティID"
          },
          "src_id": {
            "type": "string",
            "description": "関係の出発点となるクラス個体ID"
          },
          "src_label": {
            "type": "string",
            "description": "出発点クラスのラベル"
          },
          "property_iri": {
            "type": "string",
            "format": "uri",
            "description": "メタモデルで定義されたプロパティのIRI。"
          },
          "dest_id": {
            "type": "string",
            "description": "関係の到達点となるクラス個体ID"
          },
          "dest_label": {
            "type": "string",
            "description": "到達点クラスのラベル"
          },
          "strength": {
            "type": "integer",
            "description": "関係の強度: 0=関連なし(None), 1=環境的依存(Weak), 2=機能的依存(Medium), 3=必須依存(Strong)",
            "minimum": 0,
            "maximum": 3
          },
          "judgment": {
            "type": "string",
            "enum": ["ACCEPT", "REVIEW", "REJECT"],
            "description": "判定カテゴリ (ACCEPT/REVIEW/REJECT)"
          },
          "justification": {
            "type": "string",
            "description": "判定の根拠"
          }
        },
        "required": ["id", "src_id", "src_label", "property_iri", "dest_id", "dest_label", "strength", "judgment", "justification"]
      }
    }
  },
  "required": ["id", "properties"],
  "additionalProperties": false
}
