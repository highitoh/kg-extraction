{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-editor/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyEditorLLMOutput",
  "description": "LLM output schema for PropertyEditor",
  "type": "object",
  "properties": {
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revised_strength": {
            "type": "integer",
            "description": "Revised strength: 0=exclude (REJECT), 1=Weak, 2=Medium, 3=Strong",
            "minimum": 0,
            "maximum": 3
          },
          "revision_reason": {
            "type": "string",
            "description": "Reason for revision or exclusion"
          }
        },
        "required": ["revised_strength", "revision_reason"],
        "additionalProperties": false
      },
      "description": "Array of correction objects (revised strength and reason)"
    }
  },
  "required": ["corrections"],
  "additionalProperties": false
}
