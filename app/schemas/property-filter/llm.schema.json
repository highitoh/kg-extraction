{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src_id": {
            "type": "string",
            "description": "The ID of the source class"
          },
          "dest_id": {
            "type": "string",
            "description": "The ID of the destination class"
          },
          "judgment": {
            "type": "string",
            "enum": ["ACCEPT", "REVIEW", "REJECT"],
            "description": "The judgment category for the property relation"
          },
          "justification": {
            "type": "string",
            "description": "Brief justification for the decision"
          }
        },
        "required": ["src_id", "dest_id", "judgment", "justification"],
        "additionalProperties": false
      },
      "description": "Array of property relation judgments with 3-tier judgment"
    }
  },
  "required": ["relations"],
  "additionalProperties": false
}
