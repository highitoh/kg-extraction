{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/view-chain/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViewChainOutput",
  "type": "object",
  "description": "Output information for view description extraction",
  "properties": {
    "id": {
      "type": "string",
      "description": "Extraction ID"
    },
    "views": {
      "type": "array",
      "description": "Extracted view description information for each type",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "description": "View type" },
          "texts": {
            "type": "array",
            "description": "Extracted view description information",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file_id": { "type": "string", "description": "File ID" },
                "text": { "type": "string", "description": "Extracted view description" }
              },
              "required": ["file_id", "text"]
            }
          }
        },
        "required": ["type", "texts"]
      }
    }
  },
  "required": ["id", "views"],
  "additionalProperties": false
}
