{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/class-editor/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassEditorLLMOutput",
  "description": "LLM output schema for class editor",
  "type": "object",
  "properties": {
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revised_label": {
            "type": "string",
            "description": "Revised label (empty string if no revision needed)"
          },
          "should_reject": {
            "type": "boolean",
            "description": "Whether to reject (true=REJECT, false=continue REVIEW)"
          },
          "revision_reason": {
            "type": "string",
            "description": "Reason for revision or rejection"
          }
        },
        "required": ["revised_label", "should_reject", "revision_reason"],
        "additionalProperties": false
      },
      "description": "Array of correction objects with revised label and rejection flag"
    }
  },
  "required": ["corrections"],
  "additionalProperties": false
}
