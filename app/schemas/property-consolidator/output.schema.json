{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-consolidator/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyConsolidatorOutput",
  "type": "object",
  "description": "Output schema for PropertyConsolidator (same format as PropertyExtractor)",
  "properties": {
    "properties": {
      "type": "array",
      "description": "Consolidated property list",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "src_id": {"type": "string"},
          "property_iri": {"type": "string"},
          "dest_id": {"type": "string"},
          "strength": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "required": ["id", "src_id", "property_iri", "dest_id", "strength"]
      }
    }
  },
  "required": ["properties"],
  "additionalProperties": false
}
