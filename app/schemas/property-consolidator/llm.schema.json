{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-consolidator/llm.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyConsolidatorLLMOutput",
  "type": "object",
  "description": "LLM output schema for PropertyConsolidator - grouping result of similar properties",
  "properties": {
    "groups": {
      "type": "array",
      "description": "List of similar property groups",
      "items": {
        "type": "object",
        "properties": {
          "indices": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "description": "Index list of properties representing the same relationship (0-indexed)"
          },
          "reason": {
            "type": "string",
            "description": "Reason for grouping (for logging/debugging)"
          }
        },
        "required": ["indices", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["groups"],
  "additionalProperties": false
}
