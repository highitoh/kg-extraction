{
  "$id": "https://github.com/highitoh/kg-extraction/schemas/property-consolidator/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyConsolidatorInput",
  "type": "object",
  "description": "Input schema for PropertyConsolidator",
  "properties": {
    "properties": {
      "type": "array",
      "description": "Newly extracted property list",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "src_id": {"type": "string"},
          "property_iri": {"type": "string"},
          "dest_id": {"type": "string"},
          "strength": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "required": ["id", "src_id", "property_iri", "dest_id", "strength"]
      }
    },
    "existing_properties": {
      "type": "array",
      "description": "Existing property list (optional)",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "src_id": {"type": "string"},
          "property_iri": {"type": "string"},
          "dest_id": {"type": "string"},
          "strength": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "required": ["id", "src_id", "property_iri", "dest_id"]
      }
    },
    "class_info": {
      "type": "object",
      "description": "Class information (for ID normalization)",
      "properties": {
        "classes": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    }
  },
  "required": ["properties", "class_info"],
  "additionalProperties": true
}
