{
  "mcpServers": {
    "neo4j-cypher": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-neo4j-cypher"
      ],
      "env": {
        "NEO4J_URI": "bolt://neo4j:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "neo4jpassword",
        "NEO4J_DATABASE": "partner"
      }
    }
  }
}